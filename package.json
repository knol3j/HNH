{
  "name": "hashnhedge-compute",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "preview:prod": "serve -s dist -l tcp://0.0.0.0:${PORT:-3000}",
    "start": "cd agent && npm install && node server.js",
    "server": "node backend/api/index.js",
    "dev:all": "concurrently \"npm run server\" \"npm run dev\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:all": "npm run test && npm run test:backend && npm run test:agent",
    "test:backend": "cd backend/api && npm test",
    "test:agent": "cd agent && npm test",
    "verify": "powershell -ExecutionPolicy Bypass -File scripts/verify-deployment.ps1",
    "push": "powershell -ExecutionPolicy Bypass -File scripts/push-and-verify.ps1",
    "push:quick": "git push",
    "ci:status": "gh run list --limit 5"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@google/genai": "^1.31.0",
    "@react-oauth/google": "^0.12.2",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "bip39": "^3.1.0",
    "buffer": "^6.0.3",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "dexie": "^4.4.2",
    "ethers": "^5.7.2",
    "express": "^5.2.1",
    "lucide-react": "^0.555.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.14.2",
    "recharts": "^3.5.1",
    "serve": "^14.2.4",
    "socket.io-client": "^4.8.3",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "happy-dom": "^20.0.11",
    "jsdom": "^25.0.0",
    "terser": "^5.46.0",
    "vitest": "^4.0.16"
  }
}
