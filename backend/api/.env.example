# =============================================
# HashnHedge API - Environment Variables
# =============================================
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file to git.

# Server
PORT=8080
NODE_ENV=production

# REQUIRED: JWT signing secret - generate with: openssl rand -hex 64
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_SECRET

# REQUIRED: PostgreSQL connection string (set in Railway dashboard)
# Railway auto-injects this when you add a Postgres service
DATABASE_URL=postgresql://user:password@host:5432/dbname

# REQUIRED: Platform fee wallet address (your payout wallet)
PLATFORM_WALLET=YOUR_PLATFORM_WALLET_ADDRESS

# Optional: Encryption key for wallet seed storage (32+ chars)
ENCRYPTION_KEY=REPLACE_WITH_SECURE_RANDOM_KEY

# Optional: Agent secret for agent<->server communication
AGENT_SECRET=REPLACE_WITH_SECURE_AGENT_SECRET
