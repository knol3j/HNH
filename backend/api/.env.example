# Database connection string (PostgreSQL)
DATABASE_URL="postgresql://user:password@host:port/database"

# JWT Secret for token signing (REQUIRED - use a strong random string)
# Generate with: openssl rand -base64 32
JWT_SECRET="your-secure-random-jwt-secret-here"

# Node environment (affects security headers, logging, error verbosity)
# Values: development | production
NODE_ENV="production"

# Server port (optional, defaults to 8080)
PORT=8080

# Security Features (automatically enabled):
# - Rate limiting: 5 auth attempts per 15 min, 100 general requests per min
# - HTTPS redirect: Enabled in production
# - Helmet security headers: CSP, HSTS, X-Frame-Options, etc.
# - Input validation: Zod schemas on all endpoints
# - Request logging: Development=verbose, Production=errors only
