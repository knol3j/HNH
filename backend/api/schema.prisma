generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  username      String   @unique
  email         String?  @unique
  passwordHash  String?
  googleId      String?  @unique
  githubId      String?  @unique
  facebookId    String?  @unique
  appleId       String?  @unique
  tier          String   @default("free") // free, pro, enterprise
  role          String   @default("USER") // USER, ADMIN
  balance       Float    @default(0.0)
  referralCode  String   @unique
  referredBy    String?
  referralBonus Float    @default(0.0)
  createdAt     DateTime @default(now())
  walletSeed    String?  // Encrypted HD wallet mnemonic for per-user address generation
  minerConfig   String?  // JSON config for miner settings

  workers         Worker[]
  shares          Share[]
  transactions    Transaction[]
  savedWallets    UserWallet[]
  miningSessions  MiningSession[]
  statsSnapshots  StatsSnapshot[]
  achievements    UserAchievement[]
  userStats       UserStats?
  postedJobs      Job[]             @relation("PostedJobs")
  claimedJobs     Job[]             @relation("ClaimedJobs")
  agents          Agent[]
  payouts         Payout[]
}

model UserWallet {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  coin      String
  address   String
  label     String?
  poolUrl   String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, coin, address])
  @@index([userId, coin])
}

model Worker {
  id          String   @id @default(uuid())
  name        String
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  hashrate    Float    @default(0.0)
  lastSeen    DateTime @default(now())

  shares          Share[]
  miningSessions  MiningSession[]
}

model Share {
  id        String   @id @default(uuid())
  workerId  String
  worker    Worker   @relation(fields: [workerId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  difficulty Float
  accepted   Boolean @default(true)
  timestamp  DateTime @default(now())
}

model Transaction {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  amount    Float
  type      String   // MINING_PAYOUT, REFERRAL_BONUS, WITHDRAWAL
  timestamp DateTime @default(now())
}

// Mining session tracking for stats
model MiningSession {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  workerId       String?
  worker         Worker?   @relation(fields: [workerId], references: [id])

  coin           String
  poolUrl        String
  startTime      DateTime  @default(now())
  endTime        DateTime?

  totalShares    Int       @default(0)
  acceptedShares Int       @default(0)
  rejectedShares Int       @default(0)
  platformFeeShares Int    @default(0)
  userNetShares     Int    @default(0)
  avgHashrate    Float     @default(0)
  peakHashrate   Float     @default(0)

  agentId        String?
  syncedAt       DateTime?

  @@index([userId, startTime])
  @@index([workerId])
}

// Aggregated time-series stats for charts
model StatsSnapshot {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])

  period      String   // 'hourly', 'daily', 'weekly'
  timestamp   DateTime

  totalShares   Int    @default(0)
  avgHashrate   Float  @default(0)
  totalMined    Float  @default(0)
  miningMinutes Int    @default(0)

  createdAt   DateTime @default(now())

  @@unique([userId, period, timestamp])
  @@index([userId, period])
}

// Lifetime user stats for gamification
model UserStats {
  id              String    @id @default(uuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id])

  totalShares     Int       @default(0)
  totalMinedUsd   Float     @default(0)
  totalMiningTime Int       @default(0) // minutes
  platformFeesPaid Int      @default(0)

  currentStreak   Int       @default(0)
  longestStreak   Int       @default(0)
  lastMiningDate  DateTime?

  level           Int       @default(1)
  xp              Int       @default(0)
  rank            String    @default("Newbie")

  updatedAt       DateTime  @updatedAt
}

// Achievement definitions
model Achievement {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String
  icon        String?
  category    String   // 'mining', 'social', 'milestone', 'streak'
  threshold   Float?
  xpReward    Int      @default(10)

  unlocks     UserAchievement[]
}

// User's unlocked achievements
model UserAchievement {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id])

  unlockedAt    DateTime    @default(now())
  progress      Float       @default(0)

  @@unique([userId, achievementId])
  @@index([userId])
}

// Forum posts - persisted in PostgreSQL (not ephemeral file)
model ForumPost {
  id        String   @id @default(uuid())
  title     String
  content   String
  category  String
  author    String   @default("Anonymous")
  userId    String?
  likes     Int      @default(0)
  replies   Int      @default(0)
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([createdAt])
}

// Compute Marketplace: Jobs posted by users for providers to claim
model Job {
  id               String   @id @default(uuid())
  title            String
  description      String
  coin             String?
  algorithm        String?
  requiredHashrate Float?  // in H/s
  priceUsd         Float
  durationMinutes  Int?
  status           String   @default("open") // open, assigned, in-progress, completed, disputed, cancelled
  posterId         String
  poster           User     @relation("PostedJobs", fields: [posterId], references: [id])
  providerId       String?
  provider         User?    @relation("ClaimedJobs", fields: [providerId], references: [id])
  startTime        DateTime?
  endTime          DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([posterId])
  @@index([providerId])
  @@index([status])
  @@index([createdAt])
}

// Multi-Agent Management: User can register multiple agent instances
model Agent {
  id          String   @id @default(uuid())
  name        String
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  ipAddress   String?
  port        Int      @default(4343)
  secret      String   // unique per-agent secret
  lastSeen    DateTime @default(now())
  status      String   @default("offline") // online, offline, error
  meta        Json?    // arbitrary metadata (gpu info, etc)
  hardwareId  String?  // ZKP hardware fingerprint commitment
  createdAt   DateTime @default(now())

  @@unique([userId, name])
  @@index([userId])
  @@index([lastSeen])
  @@index([hardwareId])
}

// Audit Logs for security tracking
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String   // e.g., "wallet.import", "config.update", "agent.delete"
  resource  String?  // e.g., "wallet", "agent", "user"
  resourceId String?
  details   Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// Payouts / Withdrawals
model Payout {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Float
  currency  String   @default("USD")
  type      String   // "deposit" (from mining), "withdrawal", "referral", "bonus"
  status    String   @default("pending") // pending, confirmed, cancelled
  txId      String?  // blockchain transaction hash
  address   String?  // destination address for withdrawals
  createdAt DateTime @default(now())
  completedAt DateTime?

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// ==========================================
// DePIN Clustered Compute Marketplace Models
// ==========================================

model ComputeNode {
  id           String   @id @default(uuid())
  name         String
  userId       String
  cpuCores     Int      @default(4)
  cpuModel     String   @default("Generic CPU")
  gpuModel     String   @default("None")
  gpuVramGb    Float    @default(0.0)
  ramGb        Float    @default(8.0)
  storageGb    Float    @default(100.0)
  tflops       Float    @default(0.0)
  status       String   @default("idle") // idle, active, reserved, offline
  hourlyRateUsd Float   @default(0.50)
  clusterId    String?
  ipAddress    String?
  hardwareId   String?
  lastSeen     DateTime @default(now())
  createdAt    DateTime @default(now())

  cluster      ComputeCluster? @relation(fields: [clusterId], references: [id])
  workloadJobs WorkloadJob[]

  @@index([userId])
  @@index([status])
  @@index([clusterId])
}

model ComputeCluster {
  id          String   @id @default(uuid())
  name        String
  description String?
  ownerId     String
  totalNodes  Int      @default(0)
  totalTflops Float    @default(0.0)
  totalVram   Float    @default(0.0)
  status      String   @default("active") // active, degraded, offline
  region      String   @default("US-East")
  pricePerHr  Float    @default(2.50)
  createdAt   DateTime @default(now())

  nodes        ComputeNode[]
  workloadJobs WorkloadJob[]

  @@index([ownerId])
  @@index([status])
}

model WorkloadJob {
  id           String   @id @default(uuid())
  title        String
  containerImg String   @default("ubuntu:latest")
  command      String?
  reqGpuModel  String?
  reqVramGb    Float    @default(0.0)
  reqCpuCores  Int      @default(2)
  reqRamGb     Float    @default(4.0)
  status       String   @default("queued") // queued, running, completed, failed, cancelled
  buyerId      String
  nodeId       String?
  clusterId    String?
  escrowUsd    Float    @default(0.0)
  spentUsd     Float    @default(0.0)
  startedAt    DateTime?
  completedAt  DateTime?
  logs         String?
  createdAt    DateTime @default(now())

  node         ComputeNode?    @relation(fields: [nodeId], references: [id])
  cluster      ComputeCluster? @relation(fields: [clusterId], references: [id])
  billings     ComputeBilling[]

  @@index([buyerId])
  @@index([nodeId])
  @@index([clusterId])
  @@index([status])
}

model ComputeBilling {
  id          String   @id @default(uuid())
  workloadId  String
  workload    WorkloadJob @relation(fields: [workloadId], references: [id])
  providerId  String
  buyerId     String
  durationHrs Float
  grossUsd    Float
  platformFeeUsd Float // 20% marketplace fee
  netProviderUsd Float // 80% payout to provider
  createdAt   DateTime @default(now())

  @@index([workloadId])
  @@index([providerId])
  @@index([buyerId])
}

