# Production configuration
# Pointing to the live Railway backend API
VITE_API_URL=https://api-production-5f42.up.railway.app

# Agent URL (User's local miner)
# In production, this might be left empty if relying on manual user config, 
# or set to localhost if the user is expected to run the agent locally.
# VITE_AGENT_URL=https://hnh-miner.up.railway.app
# Social Login Configuration
VITE_GOOGLE_CLIENT_ID=dummy_google_client_id
VITE_GITHUB_CLIENT_ID=dummy_github_client_id
VITE_FACEBOOK_CLIENT_ID=dummy_facebook_client_id
VITE_APPLE_CLIENT_ID=dummy_apple_client_id

# Backend Configuration Fallbacks
JWT_SECRET=supersecret123
